{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@drinax/types": [
        "../../packages/types/src/index.ts"
      ],
      "@drinax/map-tokens": [
        "../../packages/map-tokens/src/index.tsx"
      ],
      "@drinax/traveller-sdk": [
        "../../packages/traveller-sdk/src/index.ts"
      ]
    },
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
